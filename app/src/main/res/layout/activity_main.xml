<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A14">

    <LinearLayout
        android:id="@+id/loginLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="FONEX"
            android:textColor="#E879F9"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="پنل مدیریت، فوروارد، اسپم و افلاینی بگیر"
            android:textColor="#38BDF8"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="#12182B"
            android:hint="آدرس سرور (https://...onrender.com)"
            android:inputType="textUri"
            android:paddingHorizontal="14dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="#12182B"
            android:hint="نام کاربری (FONEX)"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="#12182B"
            android:hint="رمز عبور"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="#8B5CF6"
            android:text="ورود به FONEX"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="نام کاربری: FONEX"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />
    </LinearLayout>

    <WebView
        android:id="@+id/panelWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
